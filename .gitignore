# ======================================================
# 大明王朝RPG - Git 忽略规则
# 依据项目审计结果：排除字节码缓存、编辑器残留、临时文件等
# ======================================================

# ---------- Python 字节码 / 运行时缓存 ----------
__pycache__/
*.py[cod]
$py.class

# ---------- 编辑器 / 工具残留 ----------
.Rhistory
*.tmp
*.swp
*.swo
*~

# ---------- 环境变量 / 密钥（防止误提交凭据） ----------
.env
.env.*
!.env.example

# ---------- 日志 ----------
*.log

# ---------- 虚拟环境 ----------
venv/
.venv/
env/
ENV/

# ---------- IDE ----------
.idea/
.vscode/

# ---------- 操作系统杂项 ----------
.DS_Store
Thumbs.db

# ---------- PyInstaller 打包产物 ----------
build/
dist/
*.spec
